{
  "name": "@kova/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"tsx watch src/ws/hocuspocus.ts\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:ws": "tsx watch src/ws/hocuspocus.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^3.4.4",
    "@hocuspocus/extension-redis": "^3.4.4",
    "@hocuspocus/server": "^3.4.4",
    "@kova/shared": "*",
    "@prisma/client": "^6",
    "bcryptjs": "^3",
    "cookie-parser": "^1",
    "cors": "^2",
    "express": "^5",
    "jsonwebtoken": "^9",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.29",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2",
    "@types/cookie-parser": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "prisma": "^6",
    "tsx": "^4",
    "typescript": "^5"
  }
}
